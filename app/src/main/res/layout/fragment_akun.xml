<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingBottom="@dimen/_20sdp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/imgProfile"
            android:layout_marginTop="@dimen/_20sdp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_width="@dimen/_60sdp"
            android:layout_height="@dimen/_60sdp" />

        <TextView
            android:id="@+id/txtNama"
            android:layout_marginTop="@dimen/_5sdp"
            app:layout_constraintTop_toBottomOf="@id/imgProfile"
            android:textSize="@dimen/_16ssp"
            android:textStyle="bold"
            android:text="Warung Darmadji"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/txtMitra"
            android:gravity="center"
            android:textStyle="italic"
            app:layout_constraintTop_toBottomOf="@id/txtNama"
            android:textSize="@dimen/_9ssp"
            android:text="Registrasi 23 Maret 2019"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutPoin"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtMitra"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_margin="@dimen/_16sdp"
            android:padding="@dimen/_10sdp"
            android:background="@drawable/bg_rounded_blue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/txtAccountNo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:text="No. Akun"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/lblpoin"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtAccountNo"
                android:text="@string/poinanda"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/txtPoin"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lblpoin"
                android:textSize="@dimen/_18ssp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <ProgressBar
                android:id="@+id/progressPoin"
                android:visibility="gone"
                android:indeterminateTint="@color/white"
                app:layout_constraintEnd_toEndOf="@id/lblpoin"
                app:layout_constraintTop_toBottomOf="@id/lblpoin"
                app:layout_constraintStart_toStartOf="@id/lblpoin"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp" />

            <Button
                android:id="@+id/btnTukarPoin"
                app:layout_constraintTop_toTopOf="@id/lblpoin"
                app:layout_constraintEnd_toEndOf="parent"
                android:text="@string/tukarpoin"
                android:textAllCaps="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/txtBerlaku"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/txtPoin"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnTukarPoin"
                android:layout_marginRight="@dimen/_8sdp"
                android:textColor="@color/white"
                android:textSize="@dimen/_8ssp"
                android:textStyle="italic"
                android:text="Berlaku hingga 31 Desember 2020\nsegera lakukan Penukaran"
                android:layout_width="0dp"
                android:layout_height="wrap_content" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:id="@+id/line"
            android:layout_marginTop="@dimen/_8sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutPoin"
            android:background="#eaeaea"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_5sdp" />

        <LinearLayout
            android:id="@+id/layoutDetail"
            android:layout_marginTop="@dimen/_8sdp"
            app:layout_constraintStart_toStartOf="parent"
            android:paddingLeft="@dimen/_16sdp"
            android:paddingRight="@dimen/_16sdp"
            android:paddingBottom="@dimen/_16sdp"
            app:layout_constraintTop_toBottomOf="@id/line"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="Informasi Detail"
                    android:textSize="@dimen/_14ssp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <Button
                    android:id="@+id/showQR"
                    android:text="QR CODE"
                    android:backgroundTint="@color/colorAccent"
                    android:layout_alignParentRight="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </RelativeLayout>

            <TextView
                android:text="@string/pemilik"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/txtPemilik"
                android:text="Maas Rahman"
                android:textStyle="bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_marginTop="@dimen/_10sdp"
                android:text="@string/notelphp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/txtTelepon"
                android:text="08123456789"
                android:textStyle="bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_marginTop="@dimen/_10sdp"
                android:text="@string/email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/txtEmail"
                android:text="asd@asd.com"
                android:textStyle="bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_marginTop="@dimen/_10sdp"
                android:text="@string/alamat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/txtAlamat"
                android:text="Desa Cikadut, Cimenyan Kabupaten Bandung"
                android:textStyle="bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <View
            android:id="@+id/line1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutDetail"
            android:background="#eaeaea"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_5sdp" />

        <RelativeLayout
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/line1"
            android:id="@+id/laporanTrans"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:padding="@dimen/_10sdp"
                android:drawablePadding="@dimen/_10sdp"
                android:text="@string/laporantrans"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:drawableLeftCompat="@drawable/ic_assignment"
                app:drawableTint="#686868" />

            <ImageView
                android:layout_marginRight="@dimen/_10sdp"
                app:srcCompat="@drawable/ic_arrow_right"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_width="@dimen/_24sdp"
                android:layout_height="@dimen/_24sdp"
                app:tint="#686868" />

        </RelativeLayout>

        <View
            android:id="@+id/line5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/laporanTrans"
            android:background="#eaeaea"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_2sdp" />

        <RelativeLayout
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/line5"
            android:id="@+id/mutasiTransaksi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:padding="@dimen/_10sdp"
                android:drawablePadding="@dimen/_10sdp"
                android:text="@string/mutasitransaksi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:drawableLeftCompat="@drawable/ic_flip"
                app:drawableTint="#686868" />

            <ImageView
                android:layout_marginRight="@dimen/_10sdp"
                app:srcCompat="@drawable/ic_arrow_right"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_width="@dimen/_24sdp"
                android:layout_height="@dimen/_24sdp"
                app:tint="#686868" />

        </RelativeLayout>

        <View
            android:id="@+id/line6"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/mutasiTransaksi"
            android:background="#eaeaea"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_2sdp" />

        <RelativeLayout
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/line6"
            android:id="@+id/ubahProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:padding="@dimen/_10sdp"
                android:drawablePadding="@dimen/_10sdp"
                android:text="@string/ubahprofile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:drawableLeftCompat="@drawable/ic_person"
                app:drawableTint="#686868" />

            <ImageView
                android:layout_marginRight="@dimen/_10sdp"
                app:srcCompat="@drawable/ic_arrow_right"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_width="@dimen/_24sdp"
                android:layout_height="@dimen/_24sdp"
                app:tint="#686868" />

        </RelativeLayout>

        <View
            android:id="@+id/line2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ubahProfile"
            android:background="#eaeaea"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_2sdp" />

        <RelativeLayout
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/line2"
            android:id="@+id/ubahPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:padding="@dimen/_10sdp"
                android:drawablePadding="@dimen/_10sdp"
                android:text="@string/ubahpassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:drawableLeftCompat="@drawable/ic_vpn_key"
                app:drawableTint="#686868" />

            <ImageView
                android:layout_marginRight="@dimen/_10sdp"
                app:srcCompat="@drawable/ic_arrow_right"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_width="@dimen/_24sdp"
                android:layout_height="@dimen/_24sdp"
                app:tint="#686868" />

        </RelativeLayout>

        <View
            android:id="@+id/line3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ubahPassword"
            android:background="#eaeaea"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_2sdp" />

        <RelativeLayout
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/line3"
            android:id="@+id/logout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:padding="@dimen/_10sdp"
                android:drawablePadding="@dimen/_10sdp"
                android:text="@string/logout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:drawableLeftCompat="@drawable/ic_exit"
                app:drawableTint="#686868" />

            <ImageView
                android:layout_marginRight="@dimen/_10sdp"
                app:srcCompat="@drawable/ic_arrow_right"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_width="@dimen/_24sdp"
                android:layout_height="@dimen/_24sdp"
                app:tint="#686868" />

        </RelativeLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutQR"
            android:visibility="invisible"
            android:background="@color/white"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_width="match_parent"
            android:layout_height="0dp">

            <View
                android:background="#eaeaea"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_5sdp" />

            <ImageView
                android:id="@+id/imgClose"
                app:srcCompat="@drawable/ic_close"
                android:layout_marginRight="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_10sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:padding="@dimen/_5sdp"
                android:layout_width="@dimen/_36sdp"
                android:layout_height="@dimen/_36sdp"
                app:tint="#686868" />

            <TextView
                android:id="@+id/txtIdPelanggan"
                android:text="ID : 101010028"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:textStyle="bold"
                android:visibility="gone"
                android:textSize="@dimen/_12ssp"
                app:layout_constraintTop_toBottomOf="@id/imgClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <ImageView
                android:layout_marginTop="@dimen/_3sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtIdPelanggan"
                app:layout_constraintBottom_toBottomOf="parent"
                android:id="@+id/imgQR"
                android:scaleType="fitCenter"
                android:layout_width="match_parent"
                android:layout_height="0dp" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
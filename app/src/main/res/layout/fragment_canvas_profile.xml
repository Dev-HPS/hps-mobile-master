<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:layout_marginTop="?actionBarSize"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/imgProfile"
            android:layout_margin="@dimen/_16sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_width="@dimen/_50sdp"
            android:layout_height="@dimen/_50sdp" />

        <TextView
            android:id="@+id/txtNama"
            android:text="Maas Rahman"
            android:textStyle="bold"
            android:layout_marginLeft="@dimen/_10sdp"
            app:layout_constraintStart_toStartOf="@id/imgProfile"
            app:layout_constraintEnd_toEndOf="@id/imgProfile"
            app:layout_constraintTop_toBottomOf="@id/imgProfile"
            android:textSize="@dimen/_12ssp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutPoin"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtNama"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_margin="@dimen/_16sdp"
            android:padding="@dimen/_10sdp"
            android:background="@drawable/bg_rounded_blue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/txtAccountNo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:text="No. Akun"
                android:textSize="@dimen/_10ssp"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />


            <TextView
                android:layout_marginTop="@dimen/_5sdp"
                android:id="@+id/lblSaldo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtAccountNo"
                android:text="@string/saldo"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/txtSaldo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lblSaldo"
                android:textSize="@dimen/_14ssp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <ProgressBar
                android:id="@+id/progressSaldo"
                android:visibility="gone"
                android:indeterminateTint="@color/white"
                app:layout_constraintStart_toStartOf="@id/lblSaldo"
                app:layout_constraintEnd_toEndOf="@id/lblSaldo"
                app:layout_constraintTop_toBottomOf="@id/lblSaldo"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp" />

            <Button
                android:id="@+id/btnTarikSaldo"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:text="@string/tarikSaldo"
                android:textSize="@dimen/_10ssp"
                android:textAllCaps="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/txtBerlaku"
                android:layout_marginTop="@dimen/_3sdp"
                app:layout_constraintTop_toBottomOf="@id/txtSaldo"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginRight="@dimen/_8sdp"
                android:textColor="@color/white"
                android:textSize="@dimen/_8ssp"
                android:textStyle="italic"
                android:text="Penarikan Saldo akan melalui Proses Konfirmasi Admin. Mohon menunggu Maksimal 2x24 Jam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:id="@+id/line1"
            android:layout_marginTop="@dimen/_10sdp"
            android:background="#eaeaea"
            app:layout_constraintTop_toBottomOf="@id/layoutPoin"
            android:layout_width="match_parent"
            android:layout_height="1dp" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutInfo"
            app:layout_constraintTop_toBottomOf="@id/line1"
            app:layout_constraintStart_toStartOf="parent"
            android:padding="@dimen/_16sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/lblInformasi"
                android:text="Informasi Detail"
                android:gravity="center"
                android:textStyle="bold"
                android:textColor="#686868"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/lblPemilik"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lblInformasi"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="@string/pemilik"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lblPemilik"
                android:id="@+id/txtPemilik"
                android:visibility="gone"
                android:text="Maas Rahman"
                android:textStyle="bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/lblNoTelp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtPemilik"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="@string/notelphp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lblNoTelp"
                android:id="@+id/txtTelepon"
                android:text="08123456789"
                android:textStyle="bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/lblEmail"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtTelepon"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="@string/email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lblEmail"
                android:id="@+id/txtEmail"
                android:text="asd@asd.com"
                android:textStyle="bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/lblAlamat"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtEmail"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="@string/alamat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lblAlamat"
                android:id="@+id/txtAlamat"
                android:text="Desa Cikadut, Cimenyan Kabupaten Bandung"
                android:textStyle="bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:id="@+id/line2"
            android:background="#eaeaea"
            app:layout_constraintTop_toBottomOf="@id/layoutInfo"
            android:layout_width="match_parent"
            android:layout_height="5dp" />

        <RelativeLayout
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/line2"
            android:id="@+id/btnUbah"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:padding="@dimen/_10sdp"
                android:drawablePadding="@dimen/_10sdp"
                android:drawableTint="#686868"
                android:text="@string/ubahprofile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:drawableLeftCompat="@drawable/ic_person" />

            <ImageView
                android:layout_marginRight="@dimen/_10sdp"
                app:srcCompat="@drawable/ic_arrow_right"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_width="@dimen/_24sdp"
                android:layout_height="@dimen/_24sdp"
                app:tint="#686868" />

        </RelativeLayout>

        <View
            android:id="@+id/line3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnUbah"
            android:background="#eaeaea"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_2sdp" />

        <RelativeLayout
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/line3"
            android:id="@+id/btnUbahPass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:padding="@dimen/_10sdp"
                android:drawablePadding="@dimen/_10sdp"
                android:text="@string/ubahpassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:drawableLeftCompat="@drawable/ic_vpn_key"
                app:drawableTint="#686868" />

            <ImageView
                android:layout_marginRight="@dimen/_10sdp"
                app:srcCompat="@drawable/ic_arrow_right"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_width="@dimen/_24sdp"
                android:layout_height="@dimen/_24sdp"
                app:tint="#686868" />

        </RelativeLayout>

        <View
            android:id="@+id/line4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnUbahPass"
            android:background="#eaeaea"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_2sdp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    xmlns:app="http://schemas.android.com/apk/res-auto">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutTagihan"
            android:padding="@dimen/_16sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/lblRingkasan"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:textSize="@dimen/_12ssp"
                android:textColor="#000"
                android:textStyle="bold"
                android:text="@string/ringkasanpemesanan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_marginTop="@dimen/_10sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lblRingkasan"
                android:id="@+id/lblTotalTagihan"
                android:text="@string/totaltagihan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/txtTotalTagihan"
                app:layout_constraintTop_toBottomOf="@id/lblTotalTagihan"
                app:layout_constraintStart_toStartOf="parent"
                android:textSize="@dimen/_12ssp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_marginTop="@dimen/_3sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtTotalTagihan"
                android:id="@+id/lblJmlItem"
                android:text="@string/jumlahitem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/txtJumlahItem"
                app:layout_constraintTop_toBottomOf="@id/lblJmlItem"
                app:layout_constraintStart_toStartOf="parent"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <Button
                android:visibility="gone"
                android:id="@+id/btnDetail"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="@id/txtJumlahItem"
                android:backgroundTint="@color/colorAccent"
                android:text="@string/detail"
                android:textAllCaps="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:id="@+id/line"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutTagihan"
            android:background="#eaeaea"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_5sdp" />

        <TextView
            android:id="@+id/lblMetode"
            android:paddingLeft="@dimen/_16sdp"
            android:paddingTop="@dimen/_16sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/line"
            android:textSize="@dimen/_12ssp"
            android:textColor="#000"
            android:textStyle="bold"
            android:text="@string/metodepembayaran"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    <TextView
        app:layout_constraintStart_toStartOf="parent"
        android:paddingLeft="@dimen/_16sdp"
        android:paddingRight="@dimen/_16sdp"
        android:textSize="@dimen/_12ssp"
        android:textColor="@color/deep_orange"
        app:layout_constraintTop_toBottomOf="@id/lblMetode"
        android:id="@+id/txtMetode"
        android:text="Belum dipilih"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

        <ExpandableListView
            android:id="@+id/recyclerMetode"
            android:layout_marginTop="@dimen/_25sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtMetode"
            app:layout_constraintBottom_toTopOf="@id/layoutBayar"
            android:layout_width="match_parent"
            android:layout_height="0dp" />

    <ProgressBar
        android:id="@+id/progbar"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/recyclerMetode"
        app:layout_constraintEnd_toEndOf="@id/recyclerMetode"
        app:layout_constraintStart_toStartOf="@id/recyclerMetode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <View
        android:id="@+id/line2"
        android:visibility="gone"
        android:background="#eaeaea"
        app:layout_constraintBottom_toTopOf="@id/layoutBayar"
        android:layout_width="match_parent"
        android:layout_height="1dp" />

        <RelativeLayout
            android:id="@+id/layoutBayar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:paddingLeft="@dimen/_10sdp"
            android:paddingRight="@dimen/_10sdp"
            android:paddingTop="@dimen/_8sdp"
            android:paddingBottom="@dimen/_8sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/txtJenis"
                android:text="Transfer Bank"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <ImageView
                android:id="@+id/imgLogoPembayaran"
                android:scaleType="fitCenter"
                android:layout_below="@id/txtJenis"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp" />

            <TextView
                android:id="@+id/txtJenisPembayaran"
                android:layout_toRightOf="@id/imgLogoPembayaran"
                android:layout_toLeftOf="@id/btnSubmit"
                android:layout_below="@id/txtJenis"
                android:layout_marginRight="@dimen/_8sdp"
                android:layout_marginLeft="@dimen/_8sdp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_below="@id/imgLogoPembayaran"
                android:id="@+id/layoutAdmin"
                android:layout_marginTop="@dimen/_5sdp"
                android:paddingBottom="@dimen/_5sdp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/lblAdmin"
                    android:text="Biaya Admin"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/txtAdmin"
                    android:text="Rp 5.000"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/lblAdmin"
                    android:textColor="@color/deep_orange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <Button
                android:id="@+id/btnSubmit"
                android:text="@string/submit"
                android:textAllCaps="false"
                android:backgroundTint="@color/colorPrimary"
                android:layout_alignParentRight="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </RelativeLayout>



</androidx.constraintlayout.widget.ConstraintLayout>

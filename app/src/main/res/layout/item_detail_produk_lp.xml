<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    app:cardUseCompatPadding="true"
    android:elevation="@dimen/_2sdp"
    app:cardElevation="@dimen/_2sdp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <CheckBox
            android:id="@+id/check"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/layoutContent"
            app:layout_constraintBottom_toBottomOf="@id/layoutContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutContent"
            android:padding="@dimen/_10sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/check"
            android:layout_marginRight="@dimen/_5sdp"
            android:layout_width="0dp"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/imgProduk"
                android:scaleType="fitCenter"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_width="@dimen/_45sdp"
                android:layout_height="@dimen/_45sdp" />

            <TextView
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:id="@+id/txtNamaProduk"
                android:text="Obat Nyamuk Cap Kingkong"
                android:textSize="@dimen/_10ssp"
                android:textStyle="bold"
                android:layout_marginLeft="@dimen/_8sdp"
                app:layout_constraintStart_toEndOf="@id/imgProduk"
                android:layout_width="0dp"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/txtHarga"
                android:textSize="@dimen/_10ssp"
                app:layout_constraintTop_toBottomOf="@id/txtNamaProduk"
                app:layout_constraintStart_toStartOf="@id/txtNamaProduk"
                android:text="Rp 50.000"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:id="@+id/line"
            android:background="#eaeaea"
            app:layout_constraintTop_toBottomOf="@id/layoutContent"
            android:layout_width="match_parent"
            android:layout_height="1dp" />

        <TextView
            app:layout_constraintStart_toStartOf="parent"
            android:text="Total"
            app:layout_constraintTop_toBottomOf="@id/line"
            android:padding="@dimen/_5sdp"
            android:textSize="@dimen/_9ssp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/txtTotalHarga"
            app:layout_constraintEnd_toEndOf="parent"
            android:text="Rp 40.000"
            android:textColor="@color/colorPrimaryDark"
            app:layout_constraintTop_toBottomOf="@id/line"
            android:padding="@dimen/_5sdp"
            android:textSize="@dimen/_9ssp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <View
            android:id="@+id/line2"
            android:background="#eaeaea"
            app:layout_constraintTop_toBottomOf="@id/txtTotalHarga"
            android:layout_width="match_parent"
            android:layout_height="1dp" />

        <TextView
            app:layout_constraintStart_toStartOf="parent"
            android:text="Jumlah Pesanan"
            android:textSize="@dimen/_9ssp"
            app:layout_constraintTop_toBottomOf="@id/line2"
            android:padding="@dimen/_5sdp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/txtJumlah"
            app:layout_constraintEnd_toEndOf="parent"
            android:text="4 Pcs"
            android:textSize="@dimen/_9ssp"
            app:layout_constraintTop_toBottomOf="@id/line2"
            android:padding="@dimen/_5sdp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <View
            android:id="@+id/line3"
            android:background="#eaeaea"
            app:layout_constraintTop_toBottomOf="@id/txtJumlah"
            android:layout_width="match_parent"
            android:layout_height="1dp" />

        <TextView
            app:layout_constraintStart_toStartOf="parent"
            android:text="Jumlah Stok"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/line3"
            android:padding="@dimen/_5sdp"
            android:textSize="@dimen/_9ssp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/txtJumlahStok"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            android:text="10 Pcs"
            android:textSize="@dimen/_9ssp"
            app:layout_constraintTop_toBottomOf="@id/line3"
            android:padding="@dimen/_5sdp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/txtProdText"
            app:layout_constraintTop_toBottomOf="@id/txtJumlahStok"
            android:gravity="center"
            android:visibility="gone"
            android:textStyle="bold|italic"
            android:padding="@dimen/_5sdp"
            android:textSize="@dimen/_8ssp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bgRed"
            android:alpha="0.2"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:background="@color/red"
            android:layout_width="match_parent"
            android:layout_height="0dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
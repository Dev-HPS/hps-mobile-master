<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutData"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:padding="@dimen/_10sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            app:layout_constraintTop_toTopOf="@id/txtKeterangan"
            app:layout_constraintBottom_toBottomOf="@id/txtTanggal"
            app:layout_constraintStart_toStartOf="parent"
            app:srcCompat="@drawable/ic_time"
            android:padding="@dimen/_2sdp"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="0dp"
            app:tint="#686868" />

        <TextView
            android:id="@+id/txtKeterangan"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginLeft="@dimen/_45sdp"
            app:layout_constraintTop_toTopOf="parent"
            android:text="Pesanan diproses oleh LP"
            android:textSize="@dimen/_12ssp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/txtTanggal"
            android:text="28 Juli 2019 10:20 WIB"
            android:textSize="@dimen/_9ssp"
            android:layout_marginLeft="@dimen/_45sdp"
            app:layout_constraintTop_toBottomOf="@id/txtKeterangan"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/layoutBelum"
        android:visibility="gone"
        android:alpha="0.4"
        android:background="#eaeaea"
        app:layout_constraintTop_toTopOf="@id/layoutData"
        app:layout_constraintBottom_toBottomOf="@id/layoutData"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_width="match_parent"
        android:layout_height="0dp" />

    <View
        app:layout_constraintTop_toBottomOf="@id/layoutData"
        android:background="#eaeaea"
        android:layout_width="match_parent"
        android:layout_height="1dp" />

</androidx.constraintlayout.widget.ConstraintLayout>